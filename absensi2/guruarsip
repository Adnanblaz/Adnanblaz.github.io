async function fetchRekap(semester) {
    const rekapContentDiv = document.getElementById('rekap-content-semester' + semester);
    rekapContentDiv.innerHTML = '<div class="text-center mt-4"><div class="spinner-border"></div><p>Memuat rekap...</p></div>';

    try {
        let siswaQuery = db.collection('siswa').where('status', '==', 'Aktif');
        if (currentUser.role === 'walikelas') {
            siswaQuery = siswaQuery.where('kelas', '==', currentUser.kelasDiampu);
        }
        const siswaSnapshot = await siswaQuery.get();

        // Ubah ini: rekapSiswa akan menjadi objek yang mengelompokkan siswa berdasarkan kelas
        const rekapSiswaByClass = {};

        siswaSnapshot.forEach(doc => {
            const siswa = doc.data();
            if (!rekapSiswaByClass[siswa.kelas]) {
                rekapSiswaByClass[siswa.kelas] = [];
            }
            // Tambahkan siswa ke dalam array kelasnya
            rekapSiswaByClass[siswa.kelas].push({ ...siswa, total: { sakit: 0, izin: 0, alpha: 0 }, detailUntukEdit: [] });
        });

        if (Object.keys(rekapSiswaByClass).length === 0) { // Cek apakah ada siswa
            rekapContentDiv.innerHTML = '<div class="alert alert-info">Tidak ada siswa untuk ditampilkan.</div>';
            return;
        }

        // Kumpulkan semua NISN dari semua kelas untuk kueri rekap bulanan
        const allNisnList = [];
        for (const kelas in rekapSiswaByClass) {
            rekapSiswaByClass[kelas].forEach(siswa => {
                allNisnList.push(siswa.nisn);
            });
        }

        const rekapPromises = [];
        const currentYear = new Date().getFullYear();
        const startMonth = semester === 1 ? 7 : 1;
        const endMonth = semester === 1 ? 12 : 6;

        // Memecah daftar NISN menjadi kelompok berisi maksimal 10
        for (let i = 0; i < allNisnList.length; i += 10) {
            const chunk = allNisnList.slice(i, i + 10);
            rekapPromises.push(
                db.collection('rekap_bulanan')
                    .where('nisn', 'in', chunk)
                    .where('tahun', '==', currentYear)
                    .where('bulan', '>=', startMonth)
                    .where('bulan', '<=', endMonth)
                    .get()
            );
        }
        const rekapSnapshots = await Promise.all(rekapPromises);

        rekapSnapshots.forEach(rekapSnapshot => {
            rekapSnapshot.forEach(doc => {
                const rekapData = doc.data();
                // Cari siswa yang sesuai di dalam rekapSiswaByClass
                // Ini memerlukan iterasi yang lebih efisien atau struktur data yang lebih baik
                // Untuk sederhana, kita akan cari dulu kelasnya, lalu siswanya
                if (rekapSiswaByClass[rekapData.kelas]) {
                    const siswaIndex = rekapSiswaByClass[rekapData.kelas].findIndex(s => s.nisn === rekapData.nisn);
                    if (siswaIndex !== -1 && rekapData.absensi) {
                        rekapData.absensi.forEach(absen => {
                            if (absen.status === 'Sakit') rekapSiswaByClass[rekapData.kelas][siswaIndex].total.sakit++;
                            if (absen.status === 'Izin') rekapSiswaByClass[rekapData.kelas][siswaIndex].total.izin++;
                            if (absen.status === 'Tanpa Keterangan') rekapSiswaByClass[rekapData.kelas][siswaIndex].total.alpha++;

                            rekapSiswaByClass[rekapData.kelas][siswaIndex].detailUntukEdit.push({
                                docId: absen.logId,
                                tanggal: absen.tanggal,
                                status: absen.status
                            });
                        });
                    }
                }
            });
        });

        // Simpan data yang sudah dikelompokkan berdasarkan kelas
        fullRekapData = rekapSiswaByClass;
        renderRekapTableContent();

    } catch (error) {
        console.error("Error fetching rekap:", error);
        rekapContentDiv.innerHTML = `<div class="alert alert-danger">Gagal memuat rekap: ${error.message}</div>`;
    }
}

// Fungsi baru untuk merender konten rekap semester (tabel atau accordion kelas)
function renderRekapTableContent() {
    const activeTab = document.querySelector('#semesterPills .nav-link.active');
    const semesterNumber = activeTab ? (activeTab.id === 'semester1-tab' ? 1 : 2) : 1;

    const rekapContentDiv = document.getElementById('rekap-content-semester' + semesterNumber);
    if (!rekapContentDiv) {
        console.error('Target rekap content div (rekap-content-semester' + semesterNumber + ') tidak ditemukan saat merender.');
        return;
    }

    let html = '';
    if (currentUser.role === 'walikelas') {
        // Untuk walikelas, fullRekapData[currentUser.kelasDiampu] akan menjadi array siswa
        // Namun, di fetchRekap, kita sudah membuat fullRekapData sebagai objek by class
        // Jadi, untuk walikelas, kita perlu mengaksesnya sebagai fullRekapData[currentUser.kelasDiampu]
        const walikelasData = fullRekapData[currentUser.kelasDiampu] || [];
        html += renderTable(walikelasData, `Rekap Kelas: ${currentUser.kelasDiampu}`);
    } else {
        html += `
            <div class="card card-body mt-3"> <h5 class="card-title mb-3"><i class="fas fa-chalkboard-teacher"></i> Rekap Absensi Per Kelas</h5>
                <div class="accordion" id="rekapClassAccordion"> `;

        // Urutkan kelas secara numerik
        const kelasKeys = Object.keys(fullRekapData).sort((a, b) => {
            // Perbaikan untuk memastikan perbandingan numerik pada nama kelas
            const numA = parseInt(a.replace(/[^0-9]/g, '')); // Ekstrak hanya angka
            const numB = parseInt(b.replace(/[^0-9]/g, ''));
            if (isNaN(numA) || isNaN(numB)) { // Jika bukan angka (misal "SD"), gunakan perbandingan string
                return a.localeCompare(b);
            }
            return numA - numB;
        });


        if (kelasKeys.length === 0) {
            html += '<div class="alert alert-info">Tidak ada data siswa untuk semester ini.</div>';
        } else {
            kelasKeys.forEach((kelas) => { // Hapus index karena tidak digunakan
                const classId = kelas.replace(/\s+/g, '');
                // Akses array siswa untuk kelas tertentu dari fullRekapData
                const dataForClass = fullRekapData[kelas]; // <--- SUDAH BENAR SEKARANG
                html += `
                    <div class="card class-accordion-item">
                        <div class="card-header" id="headingRekap${classId}">
                            <h2 class="mb-0">
                                <button class="btn btn-block text-left d-flex justify-content-between align-items-center" type="button" data-toggle="collapse" data-target="#collapseRekap${classId}" aria-expanded="false" aria-controls="collapseRekap${classId}">
                                    Kelas ${kelas}
                                    <i class="fas fa-chevron-down accordion-icon"></i>
                                </button>
                            </h2>
                        </div>
                        <div id="collapseRekap${classId}" class="collapse" aria-labelledby="headingRekap${classId}" data-parent="#rekapClassAccordion">
                            <div class="card-body">
                                ${renderTable(dataForClass, `Rekap Kelas: ${kelas}`)}
                            </div>
                        </div>
                    </div>
                `;
            });
        }

        html += `
                </div>
            </div>
        `;
    }
    rekapContentDiv.innerHTML = html;
}

function renderTable(dataSiswa, title) {
    if (!dataSiswa || dataSiswa.length === 0) return '<div class="alert alert-info">Tidak ada data siswa aktif di kelas ini.</div>';
    let tableHtml = `<div class="card"><div class="card-body"><h5 class="card-title">${title}</h5><p class="card-text small text-muted">Klik nama siswa untuk melihat rincian & melakukan koreksi.</p><div class="table-responsive"><table class="table table-hover table-sm"><thead><tr><th>No</th><th>Nama Siswa</th><th>Sakit</th><th>Izin</th><th>Alfa</th></tr></thead><tbody>`;
    dataSiswa.sort((a,b) => a.nomorAbsen - b.nomorAbsen).forEach(siswa => {
        // Memastikan details-row disembunyikan secara default
        tableHtml += `<tr onclick="toggleDetails('${siswa.nisn}')" style="cursor: pointer;"><td>${siswa.nomorAbsen}</td><td><span class="student-name">${siswa.nama}</span></td><td>${siswa.total.sakit}</td><td>${siswa.total.izin}</td><td>${siswa.total.alpha}</td></tr><tr id="detail-${siswa.nisn}" class="details-row" style="display: none;"><td colspan="5"><div class="details-content"></div></td></tr>`;
    });
    tableHtml += '</tbody></table></div></div></div>';
    return tableHtml;
}

function toggleDetails(nisn) {
    const allDetailRows = document.querySelectorAll('.details-row');
    const targetDetailRow = document.getElementById(`detail-${nisn}`);
    const wasOpen = targetDetailRow.style.display !== 'none';
    allDetailRows.forEach(row => { if(row.id !== targetDetailRow.id) row.style.display = 'none'; });
    if (!wasOpen) {
        targetDetailRow.style.display = 'table-row';
        const detailCell = targetDetailRow.querySelector('.details-content');
        if (detailCell.innerHTML.trim() === '') {
            const siswaData = findSiswaByNisn(nisn);
            detailCell.innerHTML = renderDetailContent(siswaData);
        }
    } else {
        targetDetailRow.style.display = 'none';
    }
}

function findSiswaByNisn(nisn) {
    // Loop melalui setiap array siswa di setiap kelas
    for (const kelas in fullRekapData) {
        if (Array.isArray(fullRekapData[kelas])) { // Pastikan itu array
            const siswa = fullRekapData[kelas].find(s => s.nisn === nisn);
            if (siswa) return siswa;
        }
    }
    return null; // Jika tidak ditemukan
}

function renderDetailContent(siswa) {
    if (!siswa.detailUntukEdit || siswa.detailUntukEdit.length === 0) return '<div class="alert alert-light">Tidak ada catatan ketidakhadiran untuk dikoreksi.</div>';
    let detailHtml = '<table class="table table-bordered table-sm"><thead><tr><th>Tanggal</th><th>Status</th>';
    if(currentUser.canEdit) detailHtml += '<th>Aksi</th>';
    detailHtml += '</tr></thead><tbody>';
    siswa.detailUntukEdit.sort((a,b) => new Date(b.tanggal.split(' ').reverse().join('-')) - new Date(a.tanggal.split(' ').reverse().join('-'))).forEach(d => {
        detailHtml += `<tr id="row-${d.docId}"><td>${d.tanggal}</td><td class="status-cell">${d.status}</td>`;
        if(currentUser.canEdit) {
             detailHtml += `<td class="action-cell"><button onclick="event.stopPropagation(); toggleEditMode('${d.docId}', '${d.status}')" class="btn btn-warning btn-sm" title="Edit"><i class="fas fa-edit"></i></button></td>`;
        }
        detailHtml += `</tr>`;
    });
    detailHtml += '</tbody></table>';
    return detailHtml;
}

