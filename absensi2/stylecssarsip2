/* =================================================================
   GAYA UTAMA & VARIABEL
   ================================================================= */
:root {
    --primary-color: #0056b3; /* Biru yang lebih dalam dan profesional */
    --secondary-color: #ffc107; /* Kuning sebagai aksen */
    --light-bg: #f8f9fa;
    --white-bg: #ffffff;
    --text-dark: #212529;
    --text-light: #6c757d;
    --border-radius-lg: 20px;
    --shadow-soft: 0 8px 25px rgba(0,0,0,0.05);
    --shadow-md: 0 12px 35px rgba(0,0,0,0.1);
}

body {
    font-family: 'Inter', sans-serif;
    background-color: var(--white-bg);
    color: var(--text-dark);
}

/* =================================================================
   GAYA UNTUK LANDING PAGE (index.html)
   ================================================================= */
.navbar { box-shadow: var(--shadow-soft); padding: 1rem 0; }
.hero-section {
    background: linear-gradient(rgba(255, 255, 255, 0.8), rgba(255, 255, 255, 0.8)), url('https://placehold.co/1920x1080/EAF2FF/333?text=Siswa-Siswi+Ceria') no-repeat center center;
    background-size: cover;
    padding: 100px 0;
}
.hero-section h1 { font-weight: 800; font-size: 3.5rem; color: var(--primary-color); }
.hero-section .lead { max-width: 600px; margin: 1.5rem auto; }
.btn-primary {
    background-color: var(--primary-color); border-color: var(--primary-color);
    padding: 12px 30px; font-weight: 600; border-radius: 50px; transition: all 0.3s ease;
}
.btn-primary:hover { transform: translateY(-3px); box-shadow: var(--shadow-md); }
.section-title { font-weight: 700; margin-bottom: 1rem; }
.section-subtitle { color: var(--text-light); margin-bottom: 3rem; }
.info-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 2rem; }
.info-card {
    background: var(--white-bg); padding: 2.5rem; border-radius: var(--border-radius-lg);
    box-shadow: var(--shadow-soft); text-align: center; transition: all 0.3s ease;
}
.info-card:hover { transform: translateY(-10px); box-shadow: var(--shadow-md); }
.info-card .icon { font-size: 3rem; color: var(--primary-color); margin-bottom: 1.5rem; }
.program-section .row { align-items: center; }
.program-section img { border-radius: var(--border-radius-lg); box-shadow: var(--shadow-md); }
.news-card img { border-top-left-radius: var(--border-radius-lg); border-top-right-radius: var(--border-radius-lg); height: 220px; object-fit: cover; }
.cta-section { background-color: var(--primary-color); color: white; border-radius: var(--border-radius-lg); padding: 4rem; }
.footer { background-color: var(--text-dark); color: white; }
.footer a { color: var(--secondary-color); }

/* Instagram Section Styling */
.instagram-section { background-color: var(--light-bg); }
.instagram-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(250px, 1fr)); gap: 1.5rem; }
.instagram-post { position: relative; overflow: hidden; border-radius: var(--border-radius-lg); box-shadow: var(--shadow-soft); transition: transform 0.3s ease; }
.instagram-post:hover { transform: scale(1.05); }
.instagram-post img { width: 100%; height: 100%; object-fit: cover; }

/* =================================================================
   GAYA UNTUK PORTAL (guru.html, ortu.html, arsip.html)
   ================================================================= */
.portal-body { background-color: #f8f9fa; }
.portal-container { max-width: 960px; }
.student-name { cursor: pointer; color: #007bff; text-decoration: none !important; }
.student-name:hover { color: #0056b3; }
.details-row > td { padding: 0 !important; background-color: #e9ecef !important; border: none !important; }
.details-content { padding: 1rem; }
.back-link-container { text-align: center; margin-bottom: 10px; }
.card-title-centered { text-align: center; }
#scan-modal .modal-dialog { max-width: 95%; }
#reader { width: 100%; border: 5px solid #fff; border-radius: 20px; box-shadow: 0 10px 30px rgba(0,0,0,0.1); }

/* Gaya Baru untuk Quick Dashboard */
.quick-dashboard {
    background-color: var(--white-bg);
    border-radius: var(--border-radius-lg);
    box-shadow: var(--shadow-soft);
    padding: 1.5rem;
    margin-top: 1.5rem;
    border: 1px solid #e0e0e0;
}

.quick-dashboard .card-title {
    color: var(--primary-color);
    font-weight: 700;
    font-size: 1.25rem;
}

.quick-dashboard .card-text {
    font-size: 1rem;
    line-height: 1.5;
    color: var(--text-dark);
}

.quick-dashboard .card-text strong {
    color: var(--primary-color);
    font-weight: 800;
}

/* =================================================================
   REVISI GAYA UNTUK QUICK DASHBOARD
   ================================================================= */
.quick-dashboard {
    background-color: var(--light-bg); /* Ubah ke light-bg untuk kontras */
    border-radius: var(--border-radius-lg);
    box-shadow: var(--shadow-md); /* Sedikit lebih menonjol */
    padding: 1.5rem;
    margin-top: 1.5rem;
    border: none; /* Hilangkan border */
    overflow: hidden; /* Pastikan konten tidak meluber */
}

.quick-dashboard .card-title {
    color: var(--primary-color);
    font-weight: 700;
    font-size: 1.4rem; /* Sedikit lebih besar */
    margin-bottom: 0.75rem;
    display: flex;
    align-items: center;
    gap: 10px;
}

.quick-dashboard .card-text {
    font-size: 1rem;
    line-height: 1.5;
    color: var(--text-dark);
}

/* Global Summary Card */
.quick-summary-card {
    background-color: var(--white-bg);
    border-radius: var(--border-radius-lg);
    box-shadow: var(--shadow-soft);
    padding: 1.5rem;
    margin-bottom: 1rem;
    border: 1px solid #e9ecef; /* Border lembut */
}

.quick-summary-card .summary-title {
    font-weight: 700;
    color: var(--primary-color);
    margin-bottom: 0.5rem;
    font-size: 1.25rem;
}

.quick-summary-card .summary-date {
    font-size: 0.9rem;
    color: var(--text-light);
    margin-bottom: 1.5rem;
    text-align: center;
}

.summary-metrics {
    display: flex;
    justify-content: space-around;
    flex-wrap: wrap; /* Untuk responsivitas di layar kecil */
    gap: 15px;
}

.metric-item {
    text-align: center;
    padding: 10px 15px;
    border-radius: 12px;
    flex: 1 1 120px; /* Fleksibel, tapi minimal 120px */
    min-width: 100px; /* Pastikan tidak terlalu kecil */
    box-shadow: 0 4px 10px rgba(0,0,0,0.03);
    border: 1px solid #f0f0f0;
}

.metric-item .metric-value {
    display: block;
    font-size: 1.8rem; /* Ukuran angka lebih besar */
    font-weight: 800;
    margin-bottom: 5px;
}

.metric-item .metric-label {
    display: block;
    font-size: 0.9rem;
    color: var(--text-dark);
    font-weight: 600;
}

/* Warna untuk setiap metrik */
.metric-item.present .metric-value { color: #28a745; /* Green */ }
.metric-item.return .metric-value { color: #6f42c1; /* Purple - Warna baru untuk pulang */ }
.metric-item.sick .metric-value { color: #ffc107; /* Yellow */ }
.metric-item.permission .metric-value { color: #17a2b8; /* Cyan */ }
.metric-item.absent .metric-value { color: #dc3545; /* Red */ }
.metric-item.pending .metric-value { color: #6c757d; /* Grey */ }

/* Class Details Accordion */
.class-details-card {
    background-color: var(--white-bg);
    border-radius: var(--border-radius-lg);
    box-shadow: var(--shadow-soft);
    padding: 1.5rem;
    border: 1px solid #e9ecef;
}

.class-details-card .summary-title {
    font-weight: 700;
    color: var(--primary-color);
    margin-bottom: 1.5rem;
    font-size: 1.25rem;
}

.class-accordion-item {
    border: none !important; /* Hilangkan border bawaan accordion */
    margin-bottom: 10px;
    border-radius: 15px !important;
    overflow: hidden;
    box-shadow: 0 2px 8px rgba(0,0,0,0.05);
}

.class-accordion-item .card-header {
    background-color: #f0f8ff; /* Light blue header */
    border-bottom: 1px solid #e0e0e0;
    padding: 0.75rem 1.25rem;
    border-radius: 15px 15px 0 0 !important;
}

.class-accordion-item .card-header button {
    font-weight: 600;
    color: var(--primary-color);
    text-decoration: none;
    transition: all 0.2s ease;
    padding: 0;
}

.class-accordion-item .card-header button:hover {
    color: #004085;
}

.class-accordion-item .card-header button .badge {
    background-color: var(--primary-color);
    color: white;
    font-size: 0.8em;
    padding: 0.4em 0.7em;
    border-radius: 15px;
}

.class-accordion-item .accordion-icon {
    transition: transform 0.3s ease-in-out;
}

.class-accordion-item .card-header button[aria-expanded="true"] .accordion-icon {
    transform: rotate(180deg);
}

.class-accordion-item .card-body {
    padding: 1.25rem;
    background-color: #fdfdfd; /* Background body sedikit beda */
    border-radius: 0 0 15px 15px !important;
}

.compact-metrics {
    display: flex;
    justify-content: space-between; /* Rata kiri-kanan */
    flex-wrap: wrap;
    gap: 8px; /* Jarak antar item lebih kecil */
}

.compact-metrics .metric-item {
    flex: 1 1 80px; /* Lebih kecil untuk di dalam accordion */
    padding: 8px;
    border-radius: 8px;
    box-shadow: none; /* Hilangkan bayangan untuk item kompak */
    border: 1px solid #eee;
}

.compact-metrics .metric-item .metric-value {
    font-size: 1.3rem; /* Ukuran angka lebih kecil */
}

.compact-metrics .metric-item .metric-label {
    font-size: 0.75rem; /* Ukuran label lebih kecil */
}

/* Responsiveness */
@media (max-width: 767.98px) {
    .summary-metrics {
        flex-direction: column; /* Tumpuk ke bawah di layar kecil */
    }
    .metric-item {
        flex: none;
        width: 100%;
        margin-bottom: 10px;
    }
    .compact-metrics {
        flex-wrap: wrap; /* Tetap wrap untuk kompak */
        justify-content: center;
    }
    .compact-metrics .metric-item {
        flex: 1 1 45%; /* Dua kolom di layar kecil */
    }
}