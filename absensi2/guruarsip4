async function updateQuickDashboard() {
    const dashboardSummary = dashboardContentArea; // Sekarang langsung mengisi dashboardContentArea
    dashboardSummary.innerHTML = '<div class="text-center"><span class="spinner-border spinner-border-sm"></span> Memuat ringkasan...</div>';

    const today = new Date();
    const startOfDay = new Date(today.getFullYear(), today.getMonth(), today.getDate());
    const endOfDay = new Date(today.getFullYear(), today.getMonth(), today.getDate(), 23, 59, 59);

    try {
        let totalSiswaQuery = db.collection('siswa').where('status', '==', 'Aktif');
        let logAbsensiQuery = db.collection('log_absensi')
            .where('timestamp', '>=', startOfDay)
            .where('timestamp', '<=', endOfDay);

        // Fetch all active students to get total count and class distribution
        const studentsSnapshot = await db.collection('siswa').where('status', '==', 'Aktif').get();
        const totalStudentsOverall = studentsSnapshot.size;

        let kelasFilter = '';
        if (currentUser.role === 'walikelas' && currentUser.kelasDiampu) {
            totalSiswaQuery = totalSiswaQuery.where('kelas', '==', currentUser.kelasDiampu);
            logAbsensiQuery = logAbsensiQuery.where('kelas', '==', currentUser.kelasDiampu);
            kelasFilter = currentUser.kelasDiampu;
        }

        const siswaAktifSnapshot = await totalSiswaQuery.get();
        const totalSiswaRelevant = siswaAktifSnapshot.size; // Total siswa di kelas walikelas atau semua siswa aktif untuk admin/mapel

        const logSnapshot = await logAbsensiQuery.get();

        // Maps untuk melacak NISN unik per status dan per kelas
        const globalSummary = {
            hadir: new Set(), pulang: new Set(), sakit: new Set(), izin: new Set(), alpha: new Set()
        };
        const classSummaries = {}; // { 'Kelas X': { total: N, hadir: Set, pulang: Set, sakit: Set, ... } }

        siswaAktifSnapshot.forEach(doc => {
            const siswa = doc.data();
            if (!classSummaries[siswa.kelas]) {
                classSummaries[siswa.kelas] = {
                    total: 0,
                    hadir: new Set(), pulang: new Set(), sakit: new Set(), izin: new Set(), alpha: new Set()
                };
            }
            classSummaries[siswa.kelas].total++;
        });

        logSnapshot.forEach(doc => {
            const log = doc.data();
            const kelasSiswa = log.kelas;

            if (classSummaries[kelasSiswa]) { // Hanya proses jika kelasnya relevan (ada di siswaAktifSnapshot)
                if (log.status === 'Masuk') {
                    globalSummary.hadir.add(log.nisn);
                    classSummaries[kelasSiswa].hadir.add(log.nisn);
                } else if (log.status === 'Pulang') {
                    globalSummary.pulang.add(log.nisn);
                    classSummaries[kelasSiswa].pulang.add(log.nisn);
                }
                else if (log.status === 'Sakit') {
                    globalSummary.sakit.add(log.nisn);
                    classSummaries[kelasSiswa].sakit.add(log.nisn);
                } else if (log.status === 'Izin') {
                    globalSummary.izin.add(log.nisn);
                    classSummaries[kelasSiswa].izin.add(log.nisn);
                } else if (log.status === 'Tanpa Keterangan') {
                    globalSummary.alpha.add(log.nisn);
                    classSummaries[kelasSiswa].alpha.add(log.nisn);
                }
            }
        });

        // Hitung siswa yang belum absen (yaitu siswa aktif yang belum memiliki log apapun hari ini)
        const allLoggedNisns = new Set();
        logSnapshot.forEach(doc => allLoggedNisns.add(doc.data().nisn));

        let globalBelumAbsenCount = 0;
        siswaAktifSnapshot.forEach(doc => {
            if (!allLoggedNisns.has(doc.data().nisn)) {
                globalBelumAbsenCount++;
            }
        });

        let html = '';

        // --- Bagian Global Summary ---
        // Judul disesuaikan dengan peran
        const mainTitle = currentUser.role === 'walikelas' ? `Ringkasan Absensi Hari Ini: Kelas ${currentUser.kelasDiampu}` : 'Ringkasan Absensi Hari Ini';
        const totalSiswaDisplay = currentUser.role === 'walikelas' ? totalSiswaRelevant : totalStudentsOverall;


        html += `
            <div class="quick-summary-card global-summary-card">
                <h5 class="summary-title"><i class="fas fa-calendar-day"></i> ${mainTitle}</h5>
                <p class="summary-date">${new Date().toLocaleDateString('id-ID', { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' })}</p>
                <div class="summary-metrics">
                    <div class="metric-item present">
                        <span class="metric-value">${globalSummary.hadir.size}</span>
                        <span class="metric-label">Hadir</span>
                    </div>
                    <div class="metric-item return">
                        <span class="metric-value">${globalSummary.pulang.size}</span>
                        <span class="metric-label">Pulang</span>
                    </div>
                    <div class="metric-item sick">
                        <span class="metric-value">${globalSummary.sakit.size}</span>
                        <span class="metric-label">Sakit</span>
                    </div>
                    <div class="metric-item permission">
                        <span class="metric-value">${globalSummary.izin.size}</span>
                        <span class="metric-label">Izin</span>
                    </div>
                    <div class="metric-item absent">
                        <span class="metric-value">${globalSummary.alpha.size}</span>
                        <span class="metric-label">Alfa</span>
                    </div>
                    <div class="metric-item pending">
                        <span class="metric-value">${globalBelumAbsenCount}</span>
                        <span class="metric-label">Belum Absen</span>
                    </div>
                </div>
                <p class="text-muted small mt-3 text-center">Total ${globalSummary.hadir.size + globalSummary.sakit.size + globalSummary.izin.size + globalSummary.alpha.size + globalBelumAbsenCount} dari ${totalSiswaRelevant} siswa tercatat.</p>
            </div>
        `;

        // --- Bagian Detail Per Kelas (untuk Admin dan Mapel) ---
        if (currentUser.role === 'admin' || currentUser.role === 'mapel') {
            html += `
                <div class="quick-summary-card class-details-card mt-3">
                    <h5 class="summary-title mb-3"><i class="fas fa-chalkboard-teacher"></i> Detail Absensi Per Kelas</h5>
                    <div class="accordion" id="classAccordion">
            `;

            const sortedKelas = Object.keys(classSummaries).sort();
            sortedKelas.forEach((kelas, index) => {
                const classData = classSummaries[kelas];
                const classId = kelas.replace(/\s+/g, '-').toLowerCase();

                const nisnLoggedInClass = new Set();
                logSnapshot.forEach(doc => {
                    if (doc.data().kelas === kelas) {
                        nisnLoggedInClass.add(doc.data().nisn);
                    }
                });
                const belumAbsenKelasCount = classData.total - nisnLoggedInClass.size;


                html += `
                        <div class="card class-accordion-item">
                            <div class="card-header" id="heading${classId}">
                                <h2 class="mb-0">
                                    <button class="btn btn-block text-left d-flex justify-content-between align-items-center" type="button" data-toggle="collapse" data-target="#collapse${classId}" aria-expanded="${index === 0 ? 'true' : 'false'}" aria-controls="collapse${classId}">
                                        Kelas ${kelas} <span class="badge badge-primary">${classData.hadir.size}/${classData.total} Hadir</span>
                                        <i class="fas fa-chevron-down accordion-icon"></i>
                                    </button>
                                </h2>
                            </div>
                            <div id="collapse${classId}" class="collapse ${index === 0 ? 'show' : ''}" aria-labelledby="heading${classId}" data-parent="#classAccordion">
                                <div class="card-body">
                                    <div class="summary-metrics compact-metrics">
                                        <div class="metric-item present">
                                            <span class="metric-value">${classData.hadir.size}</span>
                                            <span class="metric-label">Hadir</span>
                                        </div>
                                        <div class="metric-item return">
                                            <span class="metric-value">${classData.pulang.size}</span>
                                            <span class="metric-label">Pulang</span>
                                        </div>
                                        <div class="metric-item sick">
                                            <span class="metric-value">${classData.sakit.size}</span>
                                            <span class="metric-label">Sakit</span>
                                        </div>
                                        <div class="metric-item permission">
                                            <span class="metric-value">${classData.izin.size}</span>
                                            <span class="metric-label">Izin</span>
                                        </div>
                                        <div class="metric-item absent">
                                            <span class="metric-value">${classData.alpha.size}</span>
                                            <span class="metric-label">Alfa</span>
                                        </div>
                                        <div class="metric-item pending">
                                            <span class="metric-value">${belumAbsenKelasCount}</span>
                                            <span class="metric-label">Belum Absen</span>
                                        </div>
                                    </div>
                                    <p class="text-muted small mt-2 text-center">Total ${classData.hadir.size + classData.sakit.size + classData.izin.size + classData.alpha.size + belumAbsenKelasCount} dari ${classData.total} siswa tercatat.</p>
                                </div>
                            </div>
                        </div>
                `;
            });

            html += `
                    </div>
                </div>
            `;
        }

        dashboardSummary.innerHTML = html;

    } catch (error) {
        console.error("Error fetching quick dashboard data:", error);
        dashboardSummary.innerHTML = `<div class="alert alert-danger text-center">Gagal memuat ringkasan: ${error.message}</div>`;
    }
}
