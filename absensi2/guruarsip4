// =================================================================
// --- FUNGSI LENGKAP UNTUK REKAP, UNSCANNED, EDIT (SEBELUMNYA DI CONTENT-CONTAINER) ---
// Sekarang akan dirender di 'rekap-content' atau 'mainContentArea'
// =================================================================

async function fetchRekap(semester) {
    // Mengarahkan ke 'rekap-content' atau langsung 'mainContentArea'
    const rekapContentDiv = document.getElementById('rekap-content') || mainContentArea; 
    rekapContentDiv.innerHTML = '<div class="text-center mt-4"><div class="spinner-border"></div><p>Memuat rekap semester '+semester+'...</p></div>';

    try {
        const currentYear = new Date().getFullYear();
        const startMonth = semester === 1 ? 6 : 0;
        const endMonth = semester === 1 ? 11 : 5;
        const startDate = new Date(currentYear, startMonth, 1);
        const endDate = new Date(currentYear, endMonth + 1, 0);

        let siswaQuery = db.collection('siswa').where('status', '==', 'Aktif');
        if (currentUser.role === 'walikelas') {
            siswaQuery = siswaQuery.where('kelas', '==', currentUser.kelasDiampu);
        }
        const siswaSnapshot = await siswaQuery.get();
        let rekapSiswa = {};
        siswaSnapshot.forEach(doc => {
            const siswa = doc.data();
            rekapSiswa[siswa.nisn] = { ...siswa, total: { sakit: 0, izin: 0, alpha: 0 }, detailUntukEdit: [] };
        });

        const logSnapshot = await db.collection('log_absensi').where('timestamp', '>=', startDate).where('timestamp', '<=', endDate).get();

        logSnapshot.forEach(doc => {
            const log = doc.data();
            if (rekapSiswa[log.nisn]) {
                const status = log.status;
                if (status === "Sakit") rekapSiswa[log.nisn].total.sakit++;
                else if (status === "Izin") rekapSiswa[log.nisn].total.izin++;
                else if (status === "Tanpa Keterangan") rekapSiswa[log.nisn].total.alpha++;

                if (["Sakit", "Izin", "Tanpa Keterangan"].includes(status)) {
                    rekapSiswa[log.nisn].detailUntukEdit.push({
                        docId: doc.id,
                        tanggal: log.timestamp.toDate().toLocaleDateString("id-ID", { day: 'numeric', month: 'long', year: 'numeric' }),
                        status: status
                    });
                }
            }
        });

        const hasilArray = Object.values(rekapSiswa);

        if (currentUser.role === 'admin' || currentUser.role === 'mapel') {
            let groupedByClass = {};
            hasilArray.forEach(siswa => {
                if (!groupedByClass[siswa.kelas]) groupedByClass[siswa.kelas] = [];
                groupedByClass[siswa.kelas].push(siswa);
            });
            fullRekapData = groupedByClass;
        } else {
            fullRekapData = hasilArray;
        }
        renderDashboard(); // Ini akan memanggil renderTable yang sudah disesuaikan
    } catch (error) {
        rekapContentDiv.innerHTML = `<div class="alert alert-danger">Gagal memuat rekap: ${error.message}</div>`;
    }
}

function renderDashboard() { // Fungsi ini sekarang merender ke 'rekap-content'
    const rekapContentDiv = document.getElementById('rekap-content') || mainContentArea;
    let html = '';
    if (currentUser.role === 'walikelas') {
        html += renderTable(fullRekapData, `Rekap Kelas: ${currentUser.kelasDiampu}`);
    } else {
        html += '<div class="class-filters nav nav-pills mb-3" id="pills-tab" role="tablist">';
        const kelasKeys = Object.keys(fullRekapData).sort();
        kelasKeys.forEach((kelas, index) => {
            const kelasId = kelas.replace(/\s+/g, '');
            html += `<a class="nav-link ${index === 0 ? 'active' : ''}" data-toggle="pill" href="#pills-${kelasId}">${kelas}</a>`;
        });
        html += '</div><div class="tab-content" id="pills-tabContent">';
        kelasKeys.forEach((kelas, index) => {
            const kelasId = kelas.replace(/\s+/g, '');
            html += `<div class="tab-pane fade ${index === 0 ? 'show active' : ''}" id="pills-${kelasId}">`;
            html += renderTable(fullRekapData[kelas], `Rekap Kelas: ${kelas}`);
            html += '</div>';
        });
        html += '</div>';
    }
    rekapContentDiv.innerHTML = html;
}

function renderTable(dataSiswa, title) {
    if (!dataSiswa || dataSiswa.length === 0) return '<div class="alert alert-info">Tidak ada data siswa aktif di kelas ini.</div>';
    let tableHtml = `<div class="card"><div class="card-body"><h5 class="card-title">${title}</h5><p class="card-text small text-muted">Klik nama siswa untuk melihat rincian & melakukan koreksi.</p><div class="table-responsive"><table class="table table-hover table-sm"><thead><tr><th>No</th><th>Nama Siswa</th><th>Sakit</th><th>Izin</th><th>Alfa</th></tr></thead><tbody>`;
    dataSiswa.sort((a,b) => a.nomorAbsen - b.nomorAbsen).forEach(siswa => {
        tableHtml += `<tr onclick="toggleDetails('${siswa.nisn}')" style="cursor: pointer;"><td>${siswa.nomorAbsen}</td><td><span class="student-name">${siswa.nama}</span></td><td>${siswa.total.sakit}</td><td>${siswa.total.izin}</td><td>${siswa.total.alpha}</td></tr><tr id="detail-${siswa.nisn}" class="details-row" style="display: none;"><td colspan="5"><div class="details-content"></div></td></tr>`;
    });
    tableHtml += '</tbody></table></div></div></div>';
    return tableHtml;
}

function toggleDetails(nisn) {
    const allDetailRows = document.querySelectorAll('.details-row');
    const targetDetailRow = document.getElementById(`detail-${nisn}`);
    const wasOpen = targetDetailRow.style.display !== 'none';
    allDetailRows.forEach(row => { if(row.id !== targetDetailRow.id) row.style.display = 'none'; });
    if (!wasOpen) {
        targetDetailRow.style.display = 'table-row';
        const detailCell = targetDetailRow.querySelector('.details-content');
        if (detailCell.innerHTML.trim() === '') {
            const siswaData = findSiswaByNisn(nisn);
            detailCell.innerHTML = renderDetailContent(siswaData);
        }
    } else {
        targetDetailRow.style.display = 'none';
    }
}

function findSiswaByNisn(nisn) {
    if(Array.isArray(fullRekapData)) return fullRekapData.find(s => s.nisn === nisn);
    for(const kelas in fullRekapData) {
        const siswa = fullRekapData[kelas].find(s => s.nisn === nisn);
        if (siswa) return siswa;
    }
}

function renderDetailContent(siswa) {
    if (!siswa.detailUntukEdit || siswa.detailUntukEdit.length === 0) return '<div class="alert alert-light">Tidak ada catatan ketidakhadiran untuk dikoreksi.</div>';
    let detailHtml = '<table class="table table-bordered table-sm"><thead><tr><th>Tanggal</th><th>Status</th>';
    if(currentUser.canEdit) detailHtml += '<th>Aksi</th>';
    detailHtml += '</tr></thead><tbody>';
    siswa.detailUntukEdit.sort((a,b) => new Date(b.tanggal.split(' ').reverse().join('-')) - new Date(a.tanggal.split(' ').reverse().join('-'))).forEach(d => {
        detailHtml += `<tr id="row-${d.docId}"><td>${d.tanggal}</td><td class="status-cell">${d.status}</td>`;
        if(currentUser.canEdit) {
             detailHtml += `<td class="action-cell"><button onclick="event.stopPropagation(); toggleEditMode('${d.docId}', '${d.status}')" class="btn btn-warning btn-sm" title="Edit"><i class="fas fa-edit"></i></button></td>`;
        }
        detailHtml += `</tr>`;
    });
    detailHtml += '</tbody></table>';
    return detailHtml;
}

function toggleEditMode(docId, currentStatus) {
    const row = document.getElementById(`row-${docId}`);
    row.dataset.originalStatus = currentStatus;
    row.querySelector('.status-cell').innerHTML = `<select id="select-${docId}" class="form-control form-control-sm"><option value="Sakit">Sakit</option><option value="Izin">Izin</option><option value="Tanpa Keterangan">Tanpa Keterangan</option></select>`;
    row.querySelector(`#select-${docId}`).value = currentStatus;
    row.querySelector('.action-cell').innerHTML = `<button onclick="event.stopPropagation(); saveEdit('${docId}')" class="btn btn-success btn-sm" title="Simpan"><i class="fas fa-save"></i></button> <button onclick="event.stopPropagation(); cancelEdit('${docId}')" class="btn btn-secondary btn-sm" title="Batal"><i class="fas fa-times"></i></button>`;
}

function cancelEdit(docId) {
    const row = document.getElementById(`row-${docId}`);
    const originalStatus = row.dataset.originalStatus;
    row.querySelector('.status-cell').textContent = originalStatus;
    row.querySelector('.action-cell').innerHTML = `<button onclick="event.stopPropagation(); toggleEditMode('${docId}', '${originalStatus}')" class="btn btn-warning btn-sm" title="Edit"><i class="fas fa-edit"></i></button>`;
}

async function saveEdit(docId) {
    const actionCell = document.getElementById(`row-${docId}`).querySelector('.action-cell');
    actionCell.innerHTML = '<div class="spinner-border spinner-border-sm"></div>';
    const newStatus = document.getElementById(`select-${docId}`).value;
    try {
        await db.collection('log_absensi').doc(docId).update({ status: newStatus });
        alert('Perubahan berhasil disimpan! Silakan pilih semester lagi untuk melihat data terbaru.');
        // Setelah edit, kita mungkin ingin memperbarui dashboard atau rekap yang sedang dilihat
        // Contoh: Jika sedang melihat rekap semester, panggil kembali fetchRekap
        // contentContainer.innerHTML = ''; // Tidak perlu mengosongkan jika mau refresh yang spesifik
    } catch (error) {
        alert('Gagal menyimpan perubahan.');
        cancelEdit(docId);
    }
}

async function saveUnscanned(e) {
    e.preventDefault();
    const button = this.querySelector('button');
    button.disabled = true;
    button.innerHTML = '<span class="spinner-border spinner-border-sm"></span> Menyimpan...';
    const selections = this.querySelectorAll('select');
    const absensiData = Array.from(selections).map(select => ({ nisn: select.dataset.nisn, status: select.value })).filter(item => item.status !== "");
    if(absensiData.length === 0){
        alert('Tidak ada status yang dipilih untuk disimpan.');
        button.disabled = false; button.innerHTML = '<i class="fas fa-save"></i> Simpan Semua & Kirim Notifikasi';
        return;
    }
    try {
        const batch = db.batch();
        const siswaSnapshot = await db.collection('siswa').where('kelas', '==', currentUser.kelasDiampu).get();
        const siswaMap = new Map();
        siswaSnapshot.forEach(doc => siswaMap.set(doc.data().nisn, doc.data()));
        const tahunAjaran = new Date().getMonth() >= 6 ? `${new Date().getFullYear()}-${new Date().getFullYear() + 1}` : `${new Date().getFullYear() - 1}-${new Date().getFullYear()}`;

        absensiData.forEach(absen => {
            const siswaInfo = siswaMap.get(absen.nisn);
            if (siswaInfo) {
                const logRef = db.collection('log_absensi').doc();
                batch.set(logRef, {
                    nisn: siswaInfo.nisn, nama: siswaInfo.nama, kelas: siswaInfo.kelas,
                    nomorAbsen: siswaInfo.nomorAbsen, status: absen.status,
                    timestamp: firebase.firestore.FieldValue.serverTimestamp(),
                    tahunAjaran: tahunAjaran
                });
            }
        });
        await batch.commit();
        Toastify({
            text: 'Data siswa tidak hadir berhasil disimpan! Notifikasi akan dikirim di latar belakang.',
            duration: 3000,
            gravity: "top",
            position: "center",
            style: { background: "#4CAF50", textAlign: "center" },
        }).showToast();
        mainContentArea.innerHTML = ''; // Kosongkan form setelah berhasil
        await updateQuickDashboard(); // Perbarui dasbor setelah absensi berhasil
    } catch (error) {
        Toastify({
            text: `Gagal menyimpan: ${error.message}`,
            duration: 3000,
            gravity: "top",
            position: "center",
            style: { background: "#F44336", textAlign: "center" },
        }).showToast();
        button.disabled = false; button.innerHTML = '<i class="fas fa-save"></i> Simpan Semua & Kirim Notifikasi';
    }
}

async function saveManualAttendance(e) {
    e.preventDefault();
    const button = this.querySelector('button');
    const selectedDateString = document.getElementById('manual-date').value;

    if (!selectedDateString) {
        alert('Silakan pilih tanggal terlebih dahulu!');
        return;
    }

    button.disabled = true;
    button.innerHTML = '<span class="spinner-border spinner-border-sm"></span> Mengecek data...';

    try {
        const selectedDate = new Date(selectedDateString);
        selectedDate.setHours(8, 0, 0, 0);
        const firebaseTimestamp = firebase.firestore.Timestamp.fromDate(selectedDate);

        const existingLogQuery = await db.collection('log_absensi')
            .where('kelas', '==', currentUser.kelasDiampu)
            .where('timestamp', '==', firebaseTimestamp)
            .limit(1)
            .get();

        if (!existingLogQuery.empty) {
            alert('Data absensi untuk tanggal ini sudah pernah diisi sebelumnya. Harap hubungi admin jika ingin mengubahnya.');
            button.disabled = false;
            button.innerHTML = '<i class="fas fa-save"></i> Simpan Absensi';
            return;
        }

        button.innerHTML = '<span class="spinner-border spinner-border-sm"></span> Menyimpan...';

        const selections = this.querySelectorAll('select');
        const absensiData = Array.from(selections)
            .map(select => ({
                nisn: select.dataset.nisn,
                nama: select.dataset.nama,
                kelas: select.dataset.kelas,
                nomorAbsen: select.dataset.noabsen,
                status: select.value
            }));

        const batch = db.batch();
        const tahunAjaran = new Date(selectedDateString).getMonth() >= 6 ? `${new Date(selectedDateString).getFullYear()}-${new Date(selectedDateString).getFullYear() + 1}` : `${new Date(selectedDateString).getFullYear() - 1}-${new Date(selectedDateString).getFullYear()}`;

        absensiData.forEach(absen => {
            if (absen.status !== 'Hadir') {
                const logRef = db.collection('log_absensi').doc();
                batch.set(logRef, {
                    nisn: absen.nisn,
                    nama: absen.nama,
                    kelas: absen.kelas,
                    nomorAbsen: parseInt(absen.nomorAbsen),
                    status: absen.status,
                    timestamp: firebaseTimestamp,
                    tahunAjaran: tahunAjaran,
                    dicatatOleh: currentUser.name
                });
            }
        });

        await batch.commit();
        Toastify({
            text: `Berhasil menyimpan absensi untuk tanggal ${selectedDate.toLocaleDateString('id-ID')}.`,
            duration: 4000,
            gravity: "top",
            position: "center",
            style: { background: "#4CAF50", textAlign: "center" },
        }).showToast();
        mainContentArea.innerHTML = '';
        await updateQuickDashboard();
    } catch (error) {
        alert(`Gagal menyimpan: ${error.message}`);
    } finally {
        button.disabled = false;
        button.innerHTML = '<i class="fas fa-save"></i> Simpan Absensi';
    }
}
