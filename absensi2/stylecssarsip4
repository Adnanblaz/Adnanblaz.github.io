/* =================================================================
   GAYA UTAMA & VARIABEL
   ================================================================= */
:root {
    --primary-color: #0056b3; /* Biru yang lebih dalam dan profesional */
    --secondary-color: #ffc107; /* Kuning sebagai aksen */
    --light-bg: #f8f9fa;
    --white-bg: #ffffff;
    --text-dark: #212529;
    --text-light: #6c757d;
    --border-radius-lg: 20px;
    --shadow-soft: 0 8px 25px rgba(0,0,0,0.05);
    --shadow-md: 0 12px 35px rgba(0,0,0,0.1);
}

body {
    font-family: 'Inter', sans-serif;
    background-color: var(--white-bg);
    color: var(--text-dark);
}

/* =================================================================
   GAYA UNTUK LANDING PAGE (index.html)
   ================================================================= */
.navbar { box-shadow: var(--shadow-soft); padding: 1rem 0; }
.hero-section {
    background: linear-gradient(rgba(255, 255, 255, 0.8), rgba(255, 255, 255, 0.8)), url('https://placehold.co/1920x1080/EAF2FF/333?text=Siswa-Siswi+Ceria') no-repeat center center;
    background-size: cover;
    padding: 100px 0;
}
.hero-section h1 { font-weight: 800; font-size: 3.5rem; color: var(--primary-color); }
.hero-section .lead { max-width: 600px; margin: 1.5rem auto; }
.btn-primary {
    background-color: var(--primary-color); border-color: var(--primary-color);
    padding: 12px 30px; font-weight: 600; border-radius: 50px; transition: all 0.3s ease;
}
.btn-primary:hover { transform: translateY(-3px); box-shadow: var(--shadow-md); }
.section-title { font-weight: 700; margin-bottom: 1rem; }
.section-subtitle { color: var(--text-light); margin-bottom: 3rem; }
.info-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 2rem; }
.info-card {
    background: var(--white-bg); padding: 2.5rem; border-radius: var(--border-radius-lg);
    box-shadow: var(--shadow-soft); text-align: center; transition: all 0.3s ease;
}
.info-card:hover { transform: translateY(-10px); box-shadow: var(--shadow-md); }
.info-card .icon { font-size: 3rem; color: var(--primary-color); margin-bottom: 1.5rem; }
.program-section .row { align-items: center; }
.program-section img { border-radius: var(--border-radius-lg); box-shadow: var(--shadow-md); }
.news-card img { border-top-left-radius: var(--border-radius-lg); border-top-right-radius: var(--border-radius-lg); height: 220px; object-fit: cover; }
.cta-section { background-color: var(--primary-color); color: white; border-radius: var(--border-radius-lg); padding: 4rem; }
.footer { background-color: var(--text-dark); color: white; }
.footer a { color: var(--secondary-color); }

/* Instagram Section Styling */
.instagram-section { background-color: var(--light-bg); }
.instagram-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(250px, 1fr)); gap: 1.5rem; }
.instagram-post { position: relative; overflow: hidden; border-radius: var(--border-radius-lg); box-shadow: var(--shadow-soft); transition: transform 0.3s ease; }
.instagram-post:hover { transform: scale(1.05); }
.instagram-post img { width: 100%; height: 100%; object-fit: cover; }

/* =================================================================
   GAYA UNTUK PORTAL (guru.html, ortu.html, arsip.html)
   ================================================================= */
.portal-body {
    background-color: #f8f9fa;
    min-height: 100vh; /* Pastikan body mengisi tinggi viewport */
    overflow-x: hidden; /* Mencegah scroll horizontal yang tidak diinginkan */
}

/* Wrapper untuk Sidebar dan Konten */
.wrapper {
    display: flex;
    width: 100%;
    align-items: stretch;
    min-height: 100vh; /* Memastikan wrapper mengisi tinggi viewport */
}

/* --- Sidebar --- */
#sidebar {
    min-width: 250px;
    max-width: 250px;
    background: var(--primary-color); /* Warna primary */
    color: #fff;
    transition: all 0.3s; /* Pastikan ini ada dan tetap 0.3s */
    position: fixed; /* Sidebar tetap di tempat */
    top: 0;
    left: 0;
    height: 100vh; /* Set tinggi sidebar penuh */
    z-index: 1000; /* Pastikan di atas konten */
    box-shadow: 2px 0 10px rgba(0,0,0,0.1);
    padding-top: 20px; /* Ruang di atas header */
}

#sidebar.active {
    margin-left: -250px; /* Sembunyikan sidebar ke kiri */
}

#sidebar .sidebar-header {
    padding: 20px;
    background: #004d9e; /* Warna sedikit lebih gelap dari primary */
    text-align: center;
    border-bottom: 1px solid rgba(255,255,255,0.1);
    margin-bottom: 20px;
}

#sidebar .sidebar-header h3 {
    color: #fff;
    font-size: 1.5rem;
    font-weight: 700;
}

#sidebar ul.components {
    padding: 20px 0;
    border-bottom: 1px solid rgba(255,255,255,0.1);
}

#sidebar ul li a {
    padding: 10px 20px;
    font-size: 1.1em;
    display: block;
    color: rgba(255,255,255,0.8);
    transition: all 0.3s;
}

#sidebar ul li a:hover {
    color: var(--secondary-color); /* Ubah warna teks saat hover */
    background: #004085; /* Background saat hover */
    text-decoration: none;
}

#sidebar ul li.active > a, a[aria-expanded="true"] {
    color: #fff;
    background: #004085;
}

#sidebar ul li a i {
    margin-right: 10px;
}

#sidebar ul ul a {
    font-size: 0.9em !important;
    padding-left: 30px !important;
    background: #003366; /* Background untuk submenu */
    color: rgba(255,255,255,0.7);
}

#sidebar ul ul a:hover {
    background: #002244;
    color: var(--secondary-color);
}

.CTAs {
    padding: 20px;
    text-align: center;
}

.CTAs .logout-btn {
    background: #dc3545; /* Warna merah untuk logout */
    color: #fff;
    padding: 10px 15px;
    border-radius: 5px;
    transition: all 0.3s;
}
.CTAs .logout-btn:hover {
    background: #c82333;
    color: #fff;
    text-decoration: none;
}


/* --- Page Content --- */
#content {
    width: 100%;
    padding: 20px;
    min-height: 100vh;
    transition: all 0.3s; /* Pastikan ini ada dan tetap 0.3s */
    margin-left: 250px; /* Beri ruang untuk sidebar di desktop */
    padding-top: 70px; /* Ruang untuk navbar atas */
    position: relative;
}

#content.active {
    margin-left: 0; /* Saat sidebar ditutup, konten bergeser ke kiri */
}

#sidebar.active ~ #content {
    margin-left: 0; /* Saat sidebar ditutup, konten bergeser ke kiri */
}

/* Navbar Top (untuk tombol toggle dan welcome message) */
.custom-navbar-top {
    position: fixed;
    width: calc(100% - 250px);
    top: 0;
    left: 250px;
    z-index: 999;
    box-shadow: 0 2px 5px rgba(0,0,0,0.05);
    padding: 0.75rem 1rem;
    background-color: #ffffff !important;
    border-bottom-left-radius: 10px;
    /* TAMBAHKAN ATAU UBAH BARIS INI */
    transition: width 0.3s, left 0.3s;
}

.custom-navbar-top.active {
    width: 100% !important;
    left: 0 !important;
    border-radius: 0; /* Hapus border-radius di sini jika Anda ingin itu menghilang saat melebar */
}

#sidebar.active ~ #content .custom-navbar-top {
    width: 100%; /* Saat sidebar ditutup, navbar melebar */
    left: 0;
}


#sidebarCollapse {
    background: var(--primary-color);
    border-color: var(--primary-color);
    padding: 0.5rem 0.8rem;
    border-radius: 5px;
}
#sidebarCollapse:hover {
    background: #004085;
    border-color: #004085;
}

.navbar-text strong {
    color: var(--primary-color);
}

.portal-content-area {
    padding-top: 20px; /* Tambahan padding di bawah navbar top */
}


/* =================================================================
   GAYA UNTUK ELEMEN SPESIFIK LAINNYA (DARI KODE ANDA SEBELUMNYA)
   ================================================================= */
.student-name { cursor: pointer; color: #007bff; text-decoration: none !important; }
.student-name:hover { color: #0056b3; }
.details-row > td { padding: 0 !important; background-color: #e9ecef !important; border: none !important; }
.details-content { padding: 1rem; }
.back-link-container { text-align: center; margin-bottom: 10px; } /* Untuk halaman login */
.card-title-centered { text-align: center; } /* Untuk halaman login */
#scan-modal .modal-dialog { max-width: 95%; }
#reader { width: 100%; border: 5px solid #fff; border-radius: 20px; box-shadow: 0 10px 30px rgba(0,0,0,0.1); }


/* =================================================================
   GAYA REVISI TOTAL UNTUK QUICK DASHBOARD (DIREVISI)
   ================================================================= */
.quick-summary-card {
    background-color: var(--white-bg);
    border-radius: var(--border-radius-lg);
    box-shadow: var(--shadow-soft);
    padding: 1.5rem;
    margin-bottom: 1rem;
    border: 1px solid #e9ecef; /* Border lembut */
}

.quick-summary-card .summary-title {
    color: var(--primary-color);
    font-weight: 700;
    font-size: 1.4rem; /* Sedikit lebih besar */
    margin-bottom: 0.75rem;
    display: flex;
    align-items: center;
    gap: 10px;
}

.quick-summary-card .summary-date {
    font-size: 0.9rem;
    color: var(--text-light);
    margin-bottom: 1.5rem;
    text-align: center;
}

.summary-metrics {
    display: flex;
    justify-content: space-around;
    flex-wrap: wrap; /* Untuk responsivitas di layar kecil */
    gap: 15px;
}

.metric-item {
    text-align: center;
    padding: 10px 15px;
    border-radius: 12px;
    flex: 1 1 120px; /* Fleksibel, tapi minimal 120px */
    min-width: 100px; /* Pastikan tidak terlalu kecil */
    box-shadow: 0 4px 10px rgba(0,0,0,0.03);
    border: 1px solid #f0f0f0;
}

.metric-item .metric-value {
    display: block;
    font-size: 1.8rem; /* Ukuran angka lebih besar */
    font-weight: 800;
    margin-bottom: 5px;
}

.metric-item .metric-label {
    display: block;
    font-size: 0.9rem;
    color: var(--text-dark);
    font-weight: 600;
}

/* Warna untuk setiap metrik */
.metric-item.present .metric-value { color: #28a745; /* Green */ }
.metric-item.return .metric-value { color: #6f42c1; /* Purple */ }
.metric-item.sick .metric-value { color: #ffc107; /* Yellow */ }
.metric-item.permission .metric-value { color: #17a2b8; /* Cyan */ }
.metric-item.absent .metric-value { color: #dc3545; /* Red */ }
.metric-item.pending .metric-value { color: #6c757d; /* Grey */ }

/* Class Details Accordion */
.class-details-card {
    background-color: var(--white-bg);
    border-radius: var(--border-radius-lg);
    box-shadow: var(--shadow-soft);
    padding: 1.5rem;
    border: 1px solid #e9ecef;
}

.class-details-card .summary-title {
    font-weight: 700;
    color: var(--primary-color);
    margin-bottom: 1.5rem;
    font-size: 1.25rem;
}

.class-accordion-item {
    border: none !important; /* Hilangkan border bawaan accordion */
    margin-bottom: 10px;
    border-radius: 15px !important;
    overflow: hidden;
    box-shadow: 0 2px 8px rgba(0,0,0,0.05);
}

.class-accordion-item .card-header {
    background-color: #f0f8ff; /* Light blue header */
    border-bottom: 1px solid #e0e0e0;
    padding: 0.75rem 1.25rem;
    border-radius: 15px 15px 0 0 !important;
}

.class-accordion-item .card-header button {
    font-weight: 600;
    color: var(--primary-color);
    text-decoration: none;
    transition: all 0.2s ease;
    padding: 0;
}

.class-accordion-item .card-header button:hover {
    color: #004085;
}

.class-accordion-item .card-header button .badge {
    background-color: var(--primary-color);
    color: white;
    font-size: 0.8em;
    padding: 0.4em 0.7em;
    border-radius: 15px;
}

.class-accordion-item .accordion-icon {
    transition: transform 0.3s ease-in-out;
}

.class-accordion-item .card-header button[aria-expanded="true"] .accordion-icon {
    transform: rotate(180deg);
}

.class-accordion-item .card-body {
    padding: 1.25rem;
    background-color: #fdfdfd; /* Background body sedikit beda */
    border-radius: 0 0 15px 15px !important;
}

.compact-metrics {
    display: flex;
    justify-content: space-between; /* Rata kiri-kanan */
    flex-wrap: wrap;
    gap: 8px; /* Jarak antar item lebih kecil */
}

.compact-metrics .metric-item {
    flex: 1 1 80px; /* Lebih kecil untuk di dalam accordion */
    padding: 8px;
    border-radius: 8px;
    box-shadow: none; /* Hilangkan bayangan untuk item kompak */
    border: 1px solid #eee;
}

.compact-metrics .metric-item .metric-value {
    font-size: 1.3rem; /* Ukuran angka lebih kecil */
}

.compact-metrics .metric-item .metric-label {
    font-size: 0.75rem; /* Ukuran label lebih kecil */
}

/* =================================================================
   RESPONSIVITAS UNTUK LAYAR KECIL (MOBILE)
   ================================================================= */
@media (max-width: 768px) {
    /* Sidebar di mobile: Sembunyikan secara default, muncul saat aktif */
    #sidebar {
        margin-left: -250px; /* Sembunyikan default */
        /* Transisi sudah diatur di aturan #sidebar global */
    }
    #sidebar.active {
        margin-left: 0; /* Tampilkan saat aktif */
    }

    /* Konten utama di mobile: Selalu penuhi layar, dan navbar fixed */
    #content {
        width: 100%;
        margin-left: 0; /* Selalu di kiri */
        padding-top: 70px; /* Ruang untuk navbar */
        /* Transisi sudah diatur di aturan #content global */
    }
    /* Saat sidebar aktif, content tidak perlu digeser lagi, tapi mungkin perlu efek overlay */
    #content.active {
        /* Untuk efek overlay semi-transparan saat sidebar terbuka */
        position: relative;
        overflow: hidden; /* Sembunyikan scroll jika overlay aktif */
    }
    #content.active::before {
        content: '';
        display: block;
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: rgba(0, 0, 0, 0.5); /* Warna overlay */
        z-index: 998; /* Di bawah sidebar, di atas konten */
        cursor: pointer;
    }


    /* Navbar di mobile: Selalu penuh, dan tombol toggle ada di dalamnya */
    .custom-navbar-top {
        width: 100% !important; /* Navbar selalu penuh */
        left: 0 !important; /* Navbar selalu di kiri */
        border-radius: 0; /* Hapus radius di mobile */
        padding-left: 1rem !important; /* Reset padding kiri */
        /* Transisi sudah diatur di aturan .custom-navbar-top global */
    }

    /* Tombol toggle di mobile (di dalam navbar) */
    #sidebarCollapse span {
        display: none; /* Sembunyikan teks "Toggle Sidebar" di mobile, hanya ikon */
    }

    /* Metrik ringkasan di mobile: Tumpuk ke bawah */
    .summary-metrics {
        /* Ubah flex-direction menjadi row agar mereka berdampingan */
        flex-direction: row; 
        /* Pastikan ada wrapping untuk dua kolom */
        flex-wrap: wrap; 
        /* Atur jarak antar item */
        justify-content: space-around; /* Atau space-between, center, dll. */
        gap: 10px; /* Jarak antar kartu metrik di mobile */
    }
    .metric-item {
        /* Ini adalah kunci untuk membuat dua kolom */
        flex: 1 1 calc(50% - 10px); /* Membagi 50% lebar, dikurangi gap */
        max-width: calc(50% - 10px); /* Pastikan tidak melebihi 50% */
        margin-bottom: 0; /* Hapus margin-bottom yang tumpuk ke bawah */
        padding: 8px 10px; /* Sedikit padding lebih kecil di mobile */
        border-radius: 10px; /* Sedikit lebih kecil untuk estetika */
        font-size: 0.9em; /* Sedikit perkecil ukuran font keseluruhan item */
    }
    .metric-item .metric-value {
        font-size: 1.5rem; /* Ukuran angka disesuaikan agar pas */
    }
    .metric-item .metric-label {
        font-size: 0.8rem; /* Ukuran label disesuaikan */
    }
    /* Ini adalah bagian untuk accordion detail per kelas di mobile, biarkan saja jika sudah kompak */
    .compact-metrics {
        flex-wrap: wrap;
        justify-content: center;
    }
    .compact-metrics .metric-item {
        flex: 1 1 45%;
    }

    /* Tinggi grafik di mobile */
    .chart-container {
        height: 250px;
    }
}

/* =================================================================
   FIX: TOMBOL TOGGLE SIDEBAR DI MOBILE (PERBAIKAN ANIMASI)
   ================================================================= */
.toggle-button-fixed {
    position: fixed;
    top: 15px; /* Sesuaikan jarak dari atas */
    left: 15px; /* Sesuaikan jarak dari kiri */
    z-index: 1001; /* Pastikan di atas sidebar */
    background-color: var(--primary-color) !important;
    border-color: var(--primary-color) !important;
    color: white !important;
    padding: 8px 12px;
    border-radius: 8px;
    box-shadow: 0 4px 10px rgba(0,0,0,0.2);
    /* TAMBAHKAN ATAU UBAH BARIS INI: */
    transition: left 0.3s ease; /* Pastikan transisi untuk 'left' ada di kondisi default juga */
}

/* Modifikasi aturan ini */
#sidebar.active + #content .toggle-button-fixed {
    /* Saat sidebar aktif (terbuka), geser tombol ke kanan */
    left: 265px; /* Lebar sidebar (250px) + padding kiri (15px) */
    /* Baris transition di sini tidak lagi diperlukan jika sudah ada di atas */
}