function kirimWhatsApp(nomor, pesan) {
  const apiUrl = "https://api.fonnte.com/send";
  const payload = { 'target': nomor, 'message': pesan, 'countryCode': '62' };
  const options = {
    'method': 'post', 'contentType': 'application/json',
    'headers': { 'Authorization': WA_TOKEN }, 'payload': JSON.stringify(payload)
  };
  try { UrlFetchApp.fetch(apiUrl, options); } catch (e) { Logger.log("Gagal kirim WA: " + e.toString()); }
}

// =================================================================
// FUNGSI onFormSubmit UNTUK SCAN QR (DARI KODE ANDA)
// =================================================================
function onFormSubmit(e) {
  const response = e.values;
  const timestamp = new Date(response[0]);
  const nisn = response[1].trim();
  const statusDariForm = response[2].trim();

  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const dbSiswaSheet = ss.getSheetByName("Database Siswa");
  let logAbsensiSheet = ss.getSheetByName("Log Absensi");

  if (!logAbsensiSheet) {
    logAbsensiSheet = ss.insertSheet("Log Absensi");
    logAbsensiSheet.appendRow(["Timestamp", "NISN", "No. Absen", "Nama Siswa", "Kelas", "Status Kehadiran"]);
  }

  const dataSiswa = dbSiswaSheet.getDataRange().getValues();
  let siswaInfo = null;
  for (let i = 1; i < dataSiswa.length; i++) {
    if (dataSiswa[i][0].toString().trim() == nisn && dataSiswa[i][7].toString().trim() == "Aktif") {
      siswaInfo = {
        nisn: dataSiswa[i][0], nomorAbsen: dataSiswa[i][1], namaSiswa: dataSiswa[i][2],
        kelas: dataSiswa[i][3], namaOrtu: dataSiswa[i][4], nomorWa: dataSiswa[i][5].toString()
      };
      break;
    }
  }

  if (!siswaInfo) {
    Logger.log("Error: NISN " + nisn + " tidak ditemukan atau tidak aktif.");
    return;
  }
  
  let statusFinal = statusDariForm;
  if (statusDariForm === "Hadir / Pulang") {
    const logData = logAbsensiSheet.getDataRange().getValues();
    const hariIni = timestamp.toLocaleDateString("id-ID");
    let sudahMasukHariIni = false;
    for (let i = logData.length - 1; i > 0; i--) {
      let logTimestamp = new Date(logData[i][0]);
      if (logTimestamp.toLocaleDateString("id-ID") === hariIni && logData[i][1].toString().trim() === nisn && logData[i][5] === "Masuk") {
        sudahMasukHariIni = true;
        break;
      }
    }
    statusFinal = sudahMasukHariIni ? "Pulang" : "Masuk";
  }
  
  let pesanNotifikasi;
  const waktuScan = timestamp.toLocaleTimeString("id-ID", { hour: '2-digit', minute: '2-digit', timeZone: 'Asia/Jakarta' });
  const infoHariTanggal = timestamp.toLocaleDateString("id-ID", { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' });

  switch (statusFinal) {
    case "Masuk": pesanNotifikasi = `✅ *Notifikasi Kehadiran*\n\n*${siswaInfo.namaSiswa}* kelas ${siswaInfo.kelas} telah *hadir* di sekolah pada hari ${infoHariTanggal}.\nTerima kasih atas kerjasamanya Bapak/Ibu.`; break;
    case "Pulang": pesanNotifikasi = `🏠 *Notifikasi Pulang Sekolah*\n\n*${siswaInfo.namaSiswa}* kelas ${siswaInfo.kelas} telah selesai belajar dan *pulang* dari sekolah pada hari ${infoHariTanggal} pukul ${waktuScan}.\nMohon dijemput di sekolah atau ditunggu kepulangannya di rumah.`; break;
    case "Sakit": pesanNotifikasi = `🤒 *Informasi Kehadiran*\n\n*${siswaInfo.namaSiswa}* kelas ${siswaInfo.kelas} tidak masuk sekolah karena *sakit*.\nKami doakan semoga segera diberi kesembuhan dan bisa beraktivitas kembali.`; break;
    case "Izin": pesanNotifikasi = `✉️ *Informasi Kehadiran*\n\n*${siswaInfo.namaSiswa}* kelas ${siswaInfo.kelas} pada hari ${infoHariTanggal} tidak mengikuti kegiatan belajar karena *izin* yang telah dikonfirmasi kepada wali kelas.`; break;
    case "Tanpa Keterangan": pesanNotifikasi = `⚠️ *Konfirmasi Kehadiran*\n\n_Yth. Orang Tua/Wali ${siswaInfo.namaSiswa}_\nKami informasikan bahwa hingga saat ini ${siswaInfo.namaSiswa} kelas ${siswaInfo.kelas} *belum hadir* atau *tidak hadir tanpa keterangan* pada hari ${infoHariTanggal}.\nMohon segera konfirmasi kepada wali kelas atau melalui group kelas. Terima kasih.`; break;
    default: pesanNotifikasi = `Status kehadiran ananda *${siswaInfo.namaSiswa}* telah dicatat sebagai: *${statusFinal}*.`; break;
  }
  
  logAbsensiSheet.appendRow([timestamp, siswaInfo.nisn, siswaInfo.nomorAbsen, siswaInfo.namaSiswa, siswaInfo.kelas, statusFinal]);
  kirimWhatsApp(siswaInfo.nomorWa, pesanNotifikasi);
}

