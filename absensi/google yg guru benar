function handleStaffLogin(params, ss) {
    const dbStaffSheet = ss.getSheetByName("Database Staff");
    if (!dbStaffSheet) throw new Error("Sheet 'Database Staff' tidak ditemukan.");
    const staffData = dbStaffSheet.getDataRange().getValues();
    for (let i = 1; i < staffData.length; i++) {
        if (staffData[i][0].trim().toLowerCase() === params.username.trim().toLowerCase() && staffData[i][1].toString() === params.password) {
            return {
                name: staffData[i][2], role: staffData[i][3],
                canEdit: staffData[i][3] === 'walikelas' || staffData[i][3] === 'admin',
                kelasDiampu: staffData[i][4] || null
            };
        }
    }
    throw new Error("Username atau Password salah.");
}

function handleSiswaLogin(params, ss) {
    const { nisn, tglLahir } = params;
    if (!nisn || !tglLahir) throw new Error("NISN dan Tanggal Lahir wajib diisi.");
    const dbSiswaSheet = ss.getSheetByName("Database Siswa");
    const dataSiswa = dbSiswaSheet.getDataRange().getValues();
    for (let i = 1; i < dataSiswa.length; i++) {
        if (dataSiswa[i][0].toString().trim() == nisn && dataSiswa[i][6].toString().trim() == tglLahir && dataSiswa[i][7] === "Aktif") {
            return { nama: dataSiswa[i][2], kelas: dataSiswa[i][3] };
        }
    }
    throw new Error("NISN atau Tanggal Lahir salah, atau siswa tidak aktif.");
}

function handleOrtuRekapRequest(params, ss) {
    const { nisn, tglLahir, semester } = params;
    const cache = CacheService.getScriptCache();
    const cacheKey = `rekap_ortu_${nisn}_sem${semester}`;
    const cached = cache.get(cacheKey);
    if (cached != null) { return JSON.parse(cached); }

    let siswaData = handleSiswaLogin({nisn: nisn, tglLahir: tglLahir}, ss);
    siswaData.total = { sakit: 0, izin: 0, alpha: 0 };
    siswaData.detail = [];

    const logAbsensiSheet = ss.getSheetByName("Log Absensi");
    if (!logAbsensiSheet) return siswaData;
    const logData = logAbsensiSheet.getDataRange().getValues();
    const startMonth = parseInt(semester) === 1 ? 6 : 0;
    const endMonth = parseInt(semester) === 1 ? 11 : 5;

    logData.slice(1).forEach(row => {
        const logNisn = row[1].toString().trim();
        const logDate = new Date(row[0]);
        if (logNisn === nisn && logDate.getMonth() >= startMonth && logDate.getMonth() <= endMonth) {
            const status = row[5];
            if (status === "Sakit") siswaData.total.sakit++;
            else if (status === "Izin") siswaData.total.izin++;
            else if (status === "Tanpa Keterangan") siswaData.total.alpha++;
            siswaData.detail.push({
                timestamp: logDate.getTime(),
                tanggal: logDate.toLocaleString("id-ID", { day: 'numeric', month: 'long', year: 'numeric', hour: '2-digit', minute: '2-digit' }),
                status: status
            });
        }
    });
    siswaData.detail.sort((a, b) => b.timestamp - a.timestamp);
    cache.put(cacheKey, JSON.stringify(siswaData), 3600);
    return siswaData;
}

function handleRekapRequest(params, ss) {
    const cache = CacheService.getScriptCache();
    const cacheKey = `rekap_guru_${params.role}_${params.kelasDiampu || 'all'}_sem${params.semester}`;
    const cached = cache.get(cacheKey);
    if (cached != null) { return JSON.parse(cached); }

    const logAbsensiSheet = ss.getSheetByName("Log Absensi");
    if (!logAbsensiSheet) return [];
    const logData = logAbsensiSheet.getDataRange().getValues();
    const dbSiswaSheet = ss.getSheetByName("Database Siswa");
    const semuaSiswa = dbSiswaSheet.getDataRange().getValues();
    const semester = parseInt(params.semester);
    const startMonth = semester === 1 ? 6 : 0;
    const endMonth = semester === 1 ? 11 : 5;
    let rekapSiswa = {};

    semuaSiswa.slice(1).forEach(row => {
        const nisn = row[0].toString().trim();
        const kelasSiswa = row[3];
        const statusAktif = row[7];
        const isTargetClass = (params.role === 'walikelas' && kelasSiswa === params.kelasDiampu) || (params.role !== 'walikelas');
        if (isTargetClass && statusAktif === "Aktif") {
            rekapSiswa[nisn] = {
                nisn: nisn, nomorAbsen: row[1], nama: row[2], kelas: kelasSiswa,
                total: { sakit: 0, izin: 0, alpha: 0 },
                detailUntukEdit: []
            };
        }
    });

    logData.slice(1).forEach(row => {
        const logNisn = row[1].toString().trim();
        const logDate = new Date(row[0]);
        const logMonth = logDate.getMonth();
        const status = row[5];
        if (rekapSiswa[logNisn] && logMonth >= startMonth && logMonth <= endMonth) {
            if (status === "Sakit") rekapSiswa[logNisn].total.sakit++;
            else if (status === "Izin") rekapSiswa[logNisn].total.izin++;
            else if (status === "Tanpa Keterangan") rekapSiswa[logNisn].total.alpha++;
            if (["Sakit", "Izin", "Tanpa Keterangan"].includes(status)) {
                rekapSiswa[logNisn].detailUntukEdit.push({
                    uniqueId: `${logDate.getTime()}-${logNisn}`,
                    tanggal: logDate.toLocaleDateString("id-ID", { day: 'numeric', month: 'long', year: 'numeric' }),
                    status: status
                });
            }
        }
    });

    const hasilArray = Object.values(rekapSiswa);
    let finalResult;
    if (params.role === 'admin' || params.role === 'mapel') {
        let groupedByClass = {};
        hasilArray.forEach(siswa => {
            if (!groupedByClass[siswa.kelas]) groupedByClass[siswa.kelas] = [];
            groupedByClass[siswa.kelas].push(siswa);
        });
        finalResult = groupedByClass;
    } else {
        finalResult = hasilArray;
    }
    
    cache.put(cacheKey, JSON.stringify(finalResult), 3600);
    return finalResult;
}

function handleUnscannedRequest(params, ss) {
    const logAbsensiSheet = ss.getSheetByName("Log Absensi");
    const dbSiswaSheet = ss.getSheetByName("Database Siswa");
    const semuaSiswa = dbSiswaSheet.getDataRange().getValues();
    const logData = logAbsensiSheet ? logAbsensiSheet.getDataRange().getValues() : [];
    const hariIni = new Date().toLocaleDateString("id-ID");
    const siswaSudahAbsenHariIni = new Set();
    logData.slice(1).forEach(row => {
        if (new Date(row[0]).toLocaleDateString("id-ID") === hariIni) {
            siswaSudahAbsenHariIni.add(row[1].toString().trim());
        }
    });
    const siswaBelumAbsen = [];
    semuaSiswa.slice(1).forEach(row => {
        const nisn = row[0].toString().trim();
        const kelasSiswa = row[3];
        const statusAktif = row[7];
        if (kelasSiswa === params.kelasDiampu && statusAktif === "Aktif" && !siswaSudahAbsenHariIni.has(nisn)) {
            siswaBelumAbsen.push({ nisn: nisn, nama: row[2] });
        }
    });
    return siswaBelumAbsen.sort((a, b) => a.nama.localeCompare(b.nama));
}

function handleEditSingle(data, ss) {
    const { uniqueId, newStatus } = data;
    const sheet = ss.getSheetByName("Log Absensi");
    const logData = sheet.getDataRange().getValues();
    for (let i = 1; i < logData.length; i++) {
        let rowId = `${new Date(logData[i][0]).getTime()}-${logData[i][1].toString().trim()}`;
        if (rowId === uniqueId) {
            sheet.getRange(i + 1, 6).setValue(newStatus);
            return `Data absensi berhasil diubah menjadi ${newStatus}.`;
        }
    }
    throw new Error("Data absensi tidak ditemukan untuk diupdate.");
}

function handleSaveUnscanned(data, ss) {
    const { absensi } = data;
    const logSheet = ss.getSheetByName("Log Absensi");
    const dbSiswaSheet = ss.getSheetByName("Database Siswa");
    const dataSiswa = dbSiswaSheet.getDataRange().getValues();
    const timestamp = new Date();
    let count = 0;
    const infoHariTanggal = timestamp.toLocaleDateString("id-ID", { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' });
    absensi.forEach((absen, index) => {
        if (absen.status) {
            let siswaInfo = null;
            for (let i = 1; i < dataSiswa.length; i++) {
                if (dataSiswa[i][0].toString().trim() === absen.nisn) {
                    siswaInfo = { nisn: dataSiswa[i][0], nomorAbsen: dataSiswa[i][1], namaSiswa: dataSiswa[i][2], kelas: dataSiswa[i][3], namaOrtu: dataSiswa[i][4], nomorWa: dataSiswa[i][5].toString() };
                    break;
                }
            }
            if (siswaInfo) {
                logSheet.appendRow([timestamp, siswaInfo.nisn, siswaInfo.nomorAbsen, siswaInfo.namaSiswa, siswaInfo.kelas, absen.status]);
                let pesanNotifikasi = "";
                if (absen.status === "Sakit") pesanNotifikasi = `🤒 *Informasi Kehadiran*\n\n*${siswaInfo.namaSiswa}* kelas ${siswaInfo.kelas} tidak masuk sekolah karena *sakit*.\nKami doakan semoga segera diberi kesembuhan dan bisa beraktivitas kembali.`;
                else if (absen.status === "Izin") pesanNotifikasi = `✉️ *Informasi Kehadiran*\n\n*${siswaInfo.namaSiswa}* kelas ${siswaInfo.kelas} pada hari ${infoHariTanggal} tidak mengikuti kegiatan belajar karena *izin* yang telah dikonfirmasi kepada wali kelas.`;
                else if (absen.status === "Tanpa Keterangan") pesanNotifikasi = `⚠️ *Konfirmasi Kehadiran*\n\n_Yth. Orang Tua/Wali ${siswaInfo.namaSiswa}_\nKami informasikan bahwa hingga saat ini ${siswaInfo.namaSiswa} kelas ${siswaInfo.kelas} *belum hadir* atau *tidak hadir tanpa keterangan* pada hari ${infoHariTanggal}.\nMohon segera konfirmasi kepada wali kelas atau melalui group kelas. Terima kasih.`;
                kirimWhatsApp(siswaInfo.nomorWa, pesanNotifikasi);
                count++;
                if (index < absensi.length - 1) {
                    Utilities.sleep(3000);
                }
            }
        }
    });
    return `${count} data absensi berhasil disimpan dan notifikasi telah dikirim.`;
}
