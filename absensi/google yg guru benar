// Fungsi pembantu untuk menulis log ke Sheet
function logToSheet(keterangan, detail = "") {
  const logSheet = SpreadsheetApp.getActiveSpreadsheet().getSheetByName("Debug Log");
  if (logSheet) {
    logSheet.appendRow([new Date(), keterangan, JSON.stringify(detail)]);
  }
}

function doGet(e) {
    try {
        const params = e.parameter;
        const ss = SpreadsheetApp.getActiveSpreadsheet();
        let responseData;

        if (params.action === 'login') {
            responseData = handleStaffLogin(params, ss);
        } else if (params.action === 'getRekap') {
            responseData = handleRekapRequest(params, ss);
        } else if (params.action === 'getUnscanned') {
            responseData = handleUnscannedRequest(params, ss);
        } else if (params.action === 'loginOrtu') {
            responseData = handleSiswaLogin(params, ss);
        } else if (params.action === 'getRekapOrtu') {
            responseData = handleOrtuRekapRequest(params, ss);
        } else {
            throw new Error("Aksi tidak valid.");
        }
        return ContentService.createTextOutput(JSON.stringify({ status: "success", data: responseData })).setMimeType(ContentService.MimeType.JSON);

    } catch (error) {
        return ContentService.createTextOutput(JSON.stringify({ status: "error", message: error.message })).setMimeType(ContentService.MimeType.JSON);
    }
}

function doPost(e) {
    try {
        const data = JSON.parse(e.postData.contents);
        const ss = SpreadsheetApp.getActiveSpreadsheet();
        let resultMessage = "";

        if (data.action === 'editSingle') {
            resultMessage = handleEditSingle(data, ss);
        } else if (data.action === 'saveUnscanned') {
            resultMessage = handleSaveUnscanned(data, ss);
        } else {
            throw new Error("Aksi POST tidak dikenal.");
        }
        return ContentService.createTextOutput(JSON.stringify({ status: "success", message: resultMessage })).setMimeType(ContentService.MimeType.JSON);

    } catch (error) {
        return ContentService.createTextOutput(JSON.stringify({ status: "error", message: error.message })).setMimeType(ContentService.MimeType.JSON);
    }
}

